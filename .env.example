# Copy to .env.local and fill in values. Names only — never commit real secrets.

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App / sessions
NEXT_PUBLIC_APP_URL=
APP_BASE_URL=
SESSION_SECRET=

# reCAPTCHA (bypassed in this portfolio demo build)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# OpenAI (optional — AI follow-ups degrade gracefully when unset)
OPENAI_API_KEY=

# Capmo integration (optional)
CAPMO_API_KEY=
CAPMO_WEBHOOK_SECRET=

# Resend email (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO=

# Cron / scheduled Capmo poll
CRON_SECRET=
